# Aesthera · MedSpa Management Software — environment variables
# Copy to .env.local for local dev, set in Cloud Run via Secret Manager for prod.
# Never commit a populated .env.local — .gitignore covers it.

# ── Public site config ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://medspa-web-1030670077341.us-central1.run.app

# ── Super-admin allowlist ────────────────────────────────────────────────────
# Comma-separated emails. Only these can sign into /admin. Auto-elevated on
# first sign-in (sets the super_admin Firebase custom claim).
ADMIN_BOOTSTRAP_EMAIL=cory.salisbury@gmail.com

# ── Identity Platform (Firebase Auth) ────────────────────────────────────────
# Public Web API key — used by /api/admin/auth/callback for the REST exchange.
# Get from: https://console.cloud.google.com/customer-identity/providers?project=medspa-494718
NEXT_PUBLIC_FIREBASE_API_KEY=

# Optional — base64-encoded service account JSON for Firebase Admin SDK.
# Leave UNSET on Cloud Run (uses runtime SA via Application Default Credentials).
# Set this only for local dev or CI without ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Firestore (CRM database) ─────────────────────────────────────────────────
# Uses the (default) Firestore database in this project. No env var needed —
# the Admin SDK auto-discovers the project from ADC. To target a non-default
# database, set FIRESTORE_DATABASE_ID (rare).

# ── Demo / lead-capture pipeline ─────────────────────────────────────────────
# Where lead-capture notifications land. Defaults to person1@example.com which
# is forwarded to cory.salisbury@gmail.com via the inbound DNS forwarder.
PLATFORM_DEMO_NOTIFY_EMAIL=person1@example.com

# Calendar booking URL surfaced to prospects who pick "A 15-min demo" in the
# demo form. Renders inline as an iframe if the host is one of:
#   calendar.google.com, calendly.com, cal.com, savvycal.com, tidycal.com.
# Otherwise renders as a button. Leave unset to email-only flow (no inline
# scheduler — Cory replies manually with a calendar link).
#
# Get a Google Calendar appointment scheduling URL from:
#   https://calendar.google.com/calendar/u/0/r/settings/createappointmentschedule
# After saving the appointment schedule, copy the public booking page URL.
PLATFORM_DEMO_BOOKING_URL=

# White-glove onboarding — $1500 one-time fee.
# Create a one-time Stripe Price in the dashboard, paste the price ID here.
# When set, the "White-glove setup" card on the marketing site shows a
# "Buy onboarding" CTA that creates a Stripe Checkout session.
STRIPE_PRICE_WHITEGLOVE=

# ── Email sender domain (outbound via Resend) ────────────────────────────────
# Domain used in all `from:` addresses for transactional / marketing email.
# IMPORTANT: this domain MUST be added + verified as a sending domain in the
# Resend dashboard (SPF, DKIM, DMARC TXT records added at the DNS provider).
# Inbound forwarding (cory@, support@, etc.) is independent of outbound — both
# must be configured. Defaults to aesthera.io if unset.
AESTHERA_EMAIL_DOMAIN=aesthera.io

# Resend (transactional email) — used for both demo notifications AND admin
# magic-link sign-in emails. Get key from resend.com.
RESEND_API_KEY=

# ── Phase 2+ (placeholders, not used yet) ────────────────────────────────────
VERTEX_AI_PROJECT=medspa-494718
VERTEX_AI_LOCATION=us-central1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
